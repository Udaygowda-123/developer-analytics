{
  "name": "@pulse/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "npm run build:snippet && tsc -p tsconfig.json",
    "build:snippet": "tsx scripts/build-snippet.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "loadtest": "tsx --env-file-if-exists=../../.env scripts/loadtest.ts",
    "db:indexes": "tsx --env-file-if-exists=../../.env scripts/sync-indexes.ts"
  },
  "dependencies": {
    "@pulse/shared": "*",
    "@react-email/components": "^0.0.32",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "ioredis": "^5.4.2",
    "mongoose": "^8.9.5",
    "node-cron": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.1.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.7",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "ioredis-mock": "^8.9.0",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
