###############################################################################
# Pulse — environment configuration
#
# Copy this file to `.env` at the repo root:
#     cp .env.example .env
#
# Both apps read it: the Express service via `--env-file-if-exists`, and Next.js
# via its own `.env` loading. Every variable below is validated at boot
# (apps/ingest/src/config.ts) — a missing or malformed value crashes the process
# immediately rather than surfacing as `undefined` at 3am.
###############################################################################

# ─── Core ────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Port the Express ingestion + API service listens on.
PORT=4000

# MongoDB. `docker compose up -d` provides this as a single-node replica set.
# The `?replicaSet=rs0` suffix matters — transactions need one.
MONGODB_URI=mongodb://localhost:27017/pulse?replicaSet=rs0&directConnection=true

# Redis: rate limiting, dashboard cache, alert cooldowns, active-visitor sets.
REDIS_URL=redis://localhost:6379


# ─── Privacy ─────────────────────────────────────────────────────────────────

# HMAC secret for the cookieless session hash. Generate with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# This is what makes the stored session identifiers irreversible — without a
# server-side secret, the (IP × user-agent) input space is small enough to
# brute-force offline. Rotating it invalidates every existing session
# identifier, which is the intended emergency lever. Minimum 16 characters.
PULSE_SESSION_SECRET=change-me-to-a-long-random-string


# ─── URLs & CORS ─────────────────────────────────────────────────────────────

# Comma-separated origins allowed to call the authenticated API.
# `/collect` and `/status` are deliberately open to all origins — customers'
# websites live on domains we have never seen.
DASHBOARD_ORIGINS=http://localhost:3000

# Public URL of the dashboard, used in alert email links.
PUBLIC_APP_URL=http://localhost:3000


# ─── Firebase Authentication ─────────────────────────────────────────────────
#
# Create a project at https://console.firebase.google.com, then:
#   1. Authentication → Sign-in method → enable Email/Password and Google
#   2. Project settings → General → Your apps → Web app  (client values below)
#   3. Project settings → Service accounts → Generate new private key
#      (admin values below — these verify ID tokens server-side)

# --- Client (safe to expose; Next.js inlines NEXT_PUBLIC_* into the bundle) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Admin (SECRET — never prefix with NEXT_PUBLIC_) --------------------------
# The private key contains newlines. Keep it on one line with literal `\n`
# sequences and wrap it in double quotes; the app converts them back.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"


# ─── Email (Resend) ──────────────────────────────────────────────────────────
#
# Optional in development: with no key, alert emails are logged instead of sent,
# so the scheduler does not crash because nobody configured Resend.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com


# ─── Dashboard → API wiring ──────────────────────────────────────────────────

# Where the browser reaches the ingest service. Also the origin the tracking
# snippet posts to.
NEXT_PUBLIC_INGEST_URL=http://localhost:4000
NEXT_PUBLIC_INGEST_WS_URL=ws://localhost:4000/ws


###############################################################################
# Tunables — the defaults match the values documented in the README.
# You only need these if you are changing behaviour.
###############################################################################

# --- Ingestion buffer ---
# Flush when the buffer reaches this many events...
INGEST_BUFFER_MAX_SIZE=500
# ...or when this long has passed since the batch opened, whichever is first.
INGEST_BUFFER_MAX_AGE_MS=2000

# --- Rate limiting (per API key, sliding window) ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=10000

# --- Uptime monitoring ---
# Maximum checks in flight at once during a sweep.
MONITOR_POOL_SIZE=10
MONITOR_TIMEOUT_MS=10000
# Consecutive failures before an alert fires.
FAILURE_THRESHOLD=3
# Minimum seconds between alerts for the same monitor (3600 = one hour).
ALERT_COOLDOWN_SECONDS=3600

# --- Data lifecycle ---
# Raw events older than this are deleted, but only after they are rolled up.
EVENT_RETENTION_DAYS=90

# --- Realtime ---
# A session counts as "active" if seen within this many minutes.
ACTIVE_WINDOW_MINUTES=5
WS_BROADCAST_INTERVAL_MS=10000
WS_HEARTBEAT_INTERVAL_MS=30000

# --- Caching ---
DASHBOARD_CACHE_TTL_SECONDS=60

# --- Operational ---
# Set to `true` to start the service without registering cron jobs.
DISABLE_CRON=false
# debug | info | warn | error
LOG_LEVEL=info
